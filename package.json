{
  "name": "@echobravoyahoo/cutie",
  "type": "module",
  "version": "2.1.3",
  "description": "a general-purpose cli & library for automating mqtt interactions.",
  "main": "src/index.js",
  "bin": {
    "cutie": "built/cli-entrypoint.js"
  },
  "files": [
    "built/",
    "config/cutie.conf.json",
    "config/cutie.service",
    "cookbook.md"
  ],
  "scripts": {
    "test": "npx tsx --test './test/**/*.ts'",
    "test:watch": "npx tsx watch --test './test/**/*.ts'",
    "test:coverage": "npx c8 --src './src' --all --reporter text --reporter html tsx --test './test/**/*.ts'",
    "build": "tsc && chmod +x ./built/cli-entrypoint.js",
    "build:watch": "tsc --watch",
    "build:clean": "rm -rf built/*",
    "build:docker": "sudo docker build . -t cutie -f ./Dockerfile",
    "build:docker:wsl": "sudo docker.exe build . -t cutie -f ./Dockerfile",
    "sync": "lsyncd config.lua",
    "start": "./src/cli-entrypoint.js",
    "lint": "npx eslint",
    "prettify": "prettier -w .",
    "add-service": "sudo cp ./config/cutie.service /etc/systemd/system/cutie.service && sudo systemctl enable cutie",
    "update-service": "npm run add-service && sudo systemctl restart cutie"
  },
  "engines": "~17.9.0 - ^24",
  "author": "ashton eby",
  "license": "ISC",
  "dependencies": {
    "bme280": "^2.1.1",
    "bme680-sensor": "^1.1.0",
    "cron-schedule": "^5.0.4",
    "lodash": "^4.17.21",
    "mqtt": "^5.11.0",
    "mqtt-topics": "^1.0.2",
    "node-ble": "^1.13.0",
    "node-yaml": "^4.0.1",
    "pigpio": "^3.3.1",
    "pino": "^9.7.0",
    "pino-pretty": "^9.4.1",
    "serialport": "^10.4.0",
    "thermalprinter": "^0.3.10",
    "uuid": "^11.1.0",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "^8.0.2",
    "@types/lodash": "^4.17.19",
    "@types/node": "^24.0.14",
    "@types/yargs-parser": "^21.0.3",
    "c8": "^10.1.3",
    "chai": "^5.2.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0"
  },
  "overrides": {
    "node-gyp": "^11.0.0",
    "i2c-bus": "^5.2.3",
    "nan": "^2.22.2"
  }
}
