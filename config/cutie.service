[Unit]
Description=a cute little MQTT service
# GPIO/IR triggers and outputs talk to pigpiod over a socket via
# pigpio-client -- pigpiod needs root (enabled separately, see README.md),
# cutie itself does not. Start it first.
After=network-online.target pigpiod.service
Wants=network-online.target pigpiod.service

[Service]
User=pi
# WorkingDirectory depends on where cutie is installed, which varies by host.
# This file is a reference template: copy it, set the path below, and expect
# to maintain each host's unit by hand rather than syncing this one.
WorkingDirectory=/home/pi/workspace/cutie
# Node's install location varies (distro package, manually unpacked tarball,
# or a version manager). systemd carries no shell profile, so an nvm shim or a
# bare `npm` resolves differently here than in an interactive session. This
# cascade covers the common layouts so one ExecStart line works across them;
# add your own prefix if node lives elsewhere. On a host built by
# provisioner/configure-host.sh, /usr/bin/npm is symlinked to the installed
# Node and the first entry finds it.
Environment=PATH=/usr/bin:/usr/local/node/bin:/bin
# network-online.target can be reached before a Wi-Fi host has a route, and an
# MQTT connection that fails on its first attempt is not retried, so hold the
# start until a default route exists. A start that times out is retried by
# Restart=always.
ExecStartPre=/bin/sh -c 'until /usr/bin/ip route show default | grep -q .; do sleep 1; done'
TimeoutStartSec=180
ExecStart=/usr/bin/env npm run start:prod
Restart=always
RestartSec=2
LogNamespace=cutie

[Install]
WantedBy=multi-user.target
