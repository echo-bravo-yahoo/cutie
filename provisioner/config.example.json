{
  "hostname": "my-cutie-pi",
  "board": "pi-zero-w",
  "wifi": {
    "ssid": "your-wifi-ssid",
    "country": "US"
  },
  "locale": {
    "keymap": "us",
    "locale": "en_US.UTF-8",
    "timezone": "America/Los_Angeles"
  },
  "sshPubKey": "/home/you/.ssh/id_ed25519.pub",
  "authorizedKeys": "./authorized_keys",
  "cutie": {
    "srcPath": "..",
    "destPath": "/home/pi/workspace/cutie"
  },
  "_cutieConfig": "per-host cutie config to ship, relative to provisioner/. Omit to use the repo template, whose MQTT credentials are placeholders.",
  "cutieConfig": "./cutie.conf.my-cutie-pi.json",
  "_files": "extra files to place in the image: source file -> destination DIRECTORY",
  "files": {},
  "secrets": {
    "piPassword": "op://Vault/cutie-pi-user/password",
    "wifiPsk": "op://Vault/cutie-wifi/password"
  }
}
